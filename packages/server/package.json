{
  "name": "browserpilot-cdp",
  "version": "0.3.0",
  "description": "Zero-click, pure-CDP Chrome Extension, MCP Server & CLI for AI Agents to control, inspect, and debug real browsers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/server/index.d.ts",
  "bin": {
    "browserpilot": "dist/cli.js",
    "browserpilot-native-host": "dist/native-host.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/types/**/*.d.ts",
    "extension/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "browserpilot",
    "chrome",
    "cdp",
    "chrome-devtools-protocol",
    "devtools",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "browser-automation",
    "chrome-extension",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy-tuoren/browserpilot.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/xy-tuoren/browserpilot#readme",
  "bugs": {
    "url": "https://github.com/xy-tuoren/browserpilot/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "diff": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@browserpilot/core": "workspace:*",
    "@browserpilot/protocol": "workspace:*",
    "@types/ws": "^8.5.14"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e-full.test.ts",
    "clean": "rm -rf dist extension README.md LICENSE"
  }
}
